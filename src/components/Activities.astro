---
import SectionHead from './SectionHead.astro';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { activities: a } = t(locale);
const cardStyles = ['bg-pop', 'bg-sun', 'bg-leaf', 'bg-sky text-white'];
---
<!-- Tanpa JS: daftar bisa digeser ke samping. Dengan JS: section di-pin dan bergeser mengikuti scroll. -->
<section id="activities" class="scroll-mt-0 overflow-x-clip border-y-[3px] border-ink bg-paper-deep">
  <div class="flex min-h-svh flex-col justify-center py-20" data-hscroll>
    <div class="section-x">
      <SectionHead locale={locale} kicker={a.kicker} title={a.title} sample={a.sample} accent="text-leaf" />
    </div>
    <ul
      class="section-x mt-10 flex snap-x gap-5 overflow-x-auto pb-6 pt-2 sm:gap-8"
      data-hscroll-track
      tabindex="0"
      aria-label={a.title}
    >
      {
        a.items.map((item, i) => (
          <li
            class:list={[
              'flex min-h-[21rem] w-[min(78vw,27rem)] shrink-0 snap-start flex-col border-[3px] border-ink p-6 shadow-hard sm:min-h-[24rem] sm:p-8',
              cardStyles[i % cardStyles.length],
            ]}
            style={`rotate:${i % 2 ? 1.5 : -1.5}deg`}
          >
            <p class="font-display text-6xl font-extrabold leading-none tracking-[-0.05em] opacity-90 sm:text-7xl">
              {String(i + 1).padStart(2, '0')}
            </p>
            <p class="mt-auto font-hand text-3xl font-semibold leading-none">{item.role}</p>
            <h3 class="mt-1 font-display text-3xl font-extrabold leading-none tracking-[-0.03em] sm:text-4xl">{item.org}</h3>
            <p class="mt-3 text-lg leading-snug">{item.text}</p>
            <p class="mt-4 w-fit rounded-full border-2 border-current px-3 py-0.5 text-sm font-semibold">{item.period}</p>
          </li>
        ))
      }
      <li class="w-1 shrink-0" aria-hidden="true"></li>
    </ul>
  </div>
</section>
