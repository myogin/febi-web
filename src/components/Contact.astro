---
import Doodle from './Doodle.astro';
import { site, t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { contact } = t(locale);
const year = new Date().getFullYear();
---
<section id="contact" class="relative overflow-clip bg-ink text-paper">
  <div class="section flex min-h-svh flex-col pb-10 md:pb-12">
    <p class="font-hand text-3xl font-semibold text-sun"><span class="inline-block -rotate-2">{contact.kicker}</span></p>
    <h2
      class="mt-2 overflow-clip pb-[0.08em] font-display text-[clamp(3.6rem,17.5vw,18rem)] font-extrabold uppercase leading-[0.86] tracking-[-0.055em]"
      aria-label={contact.title}
    >
      <span class="inline-block" aria-hidden="true" data-giant>{contact.title}</span>
    </h2>
    <Doodle name="scribble" class="mt-4 h-10 w-44 text-pop sm:w-64" stroke={6} data-draw />

    <div class="mb-20 mt-10 grid gap-8 md:grid-cols-[1fr_auto] md:items-end" data-rise>
      <p class="max-w-[26ch] font-display text-2xl font-semibold leading-snug sm:text-4xl">{contact.body}</p>
      <div class="flex flex-wrap items-center gap-4">
        <a class="btn btn--lg" href={site.instagram} target="_blank" rel="noopener noreferrer" data-magnetic>
          <span class="sr-only">{contact.instagram}: </span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5h.01" /></svg>
          {site.instagramHandle}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        {
          site.email && (
            <a class="btn btn--lg btn--alt" href={`mailto:${site.email}`} data-magnetic>
              {contact.email}
            </a>
          )
        }
      </div>
    </div>

    <footer class="mt-auto flex flex-wrap items-center justify-between gap-4 border-t-[3px] border-paper/30 pt-6 text-base">
      <p>© {year} {site.name}. {contact.footer}</p>
      <a href="#main" class="inline-flex min-h-11 items-center gap-2 font-hand text-2xl font-semibold text-sun underline-offset-4 hover:underline">
        {contact.top}
        <svg width="18" height="26" viewBox="0 0 18 34" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 32V4M2 11l7-8 7 8" /></svg>
      </a>
    </footer>
  </div>
</section>
