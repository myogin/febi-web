---
// Coretan tangan SVG. Tiap path memakai pathLength=1 supaya bisa "digambar" oleh GSAP.
interface Props {
  name: keyof typeof shapes;
  class?: string;
  stroke?: number;
  [key: `data-${string}`]: string | boolean | undefined;
}
const shapes = {
  underline: { box: '0 0 300 24', d: ['M4 14 C 40 4, 70 22, 108 12 S 180 4, 214 13 S 270 20, 296 8'] },
  arrow: {
    box: '0 0 120 90',
    d: ['M8 10 C 30 60, 62 76, 104 66', 'M84 50 L 106 66 L 82 82'],
  },
  circle: {
    box: '0 0 200 120',
    d: ['M100 10 C 40 6, 8 36, 12 64 C 16 100, 76 114, 120 108 C 170 100, 196 74, 188 46 C 180 16, 130 4, 84 14'],
  },
  star: {
    box: '0 0 100 100',
    d: ['M50 8 L 61 38 L 93 39 L 67 58 L 77 90 L 50 71 L 23 90 L 33 58 L 7 39 L 39 38 Z'],
  },
  spark: {
    box: '0 0 80 80',
    d: ['M40 6 V 28', 'M40 52 V 74', 'M6 40 H 28', 'M52 40 H 74', 'M16 16 L 28 28', 'M52 52 L 64 64'],
  },
  scribble: {
    box: '0 0 160 60',
    d: ['M6 40 C 20 6, 34 6, 40 34 S 60 56, 68 24 S 90 6, 98 36 S 118 54, 126 22 S 146 10, 154 30'],
  },
} as const;
const { name, class: cls, stroke = 5, ...rest } = Astro.props;
const shape = shapes[name];
---
<svg class:list={['doodle', cls]} viewBox={shape.box} aria-hidden="true" focusable="false" overflow="visible" {...rest}>
  {shape.d.map((d) => <path d={d} pathLength="1" stroke-width={stroke} vector-effect="non-scaling-stroke" />)}
</svg>
