---
import SectionHead from './SectionHead.astro';
import Doodle from './Doodle.astro';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { gallery } = t(locale);
// PLACEHOLDER: "karya" di bawah hanya blok warna + coretan. Ganti dengan <Image> dari src/assets/gallery/.
const art = [
  { bg: 'bg-sun', ink: 'text-ink', shape: 'star', rot: -3 },
  { bg: 'bg-sky', ink: 'text-white', shape: 'scribble', rot: 2 },
  { bg: 'bg-pop', ink: 'text-ink', shape: 'circle', rot: -1.5 },
  { bg: 'bg-leaf', ink: 'text-ink', shape: 'spark', rot: 3 },
  { bg: 'bg-paper-deep', ink: 'text-pop', shape: 'scribble', rot: -2.5 },
  { bg: 'bg-ink', ink: 'text-sun', shape: 'star', rot: 1.5 },
] as const;
---
<section id="gallery" class="overflow-x-clip">
  <div class="section">
    <SectionHead locale={locale} kicker={gallery.kicker} title={gallery.title} sample={gallery.sample} />
    <ul class="mt-14 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-8 lg:mt-20 lg:grid-cols-3 lg:gap-x-12 lg:gap-y-16" data-scatter>
      {
        gallery.items.map((item, i) => {
          const a = art[i % art.length];
          return (
            <li style={`rotate:${a.rot}deg`} class:list={[i % 3 === 1 && 'lg:mt-14']}>
              <figure class="polaroid relative border-[3px] border-ink bg-white p-2.5 pb-3 shadow-hard transition-[rotate,scale] duration-300 sm:p-4">
                <span class="polaroid__tape" />
                <div class:list={['grid aspect-[4/5] place-items-center border-[3px] border-ink', a.bg, a.ink]}>
                  <Doodle name={a.shape} class="h-1/2 w-1/2" stroke={6} />
                </div>
                <figcaption class="mt-3">
                  <p class="font-display text-lg font-bold leading-tight sm:text-2xl">{item.title}</p>
                  <p class="font-hand text-xl font-semibold text-ink-soft">{item.medium}</p>
                </figcaption>
              </figure>
            </li>
          );
        })
      }
    </ul>
    <p class="mt-12 text-center font-hand text-3xl font-semibold text-sky">{gallery.note}</p>
  </div>
</section>

<style>
  .polaroid:hover {
    rotate: 2deg;
    scale: 1.04;
  }
  .polaroid__tape {
    position: absolute;
    left: 50%;
    top: -0.8rem;
    width: 5rem;
    height: 1.4rem;
    translate: -50% 0;
    rotate: -3deg;
    border: 2px solid var(--color-ink);
    background: color-mix(in srgb, var(--color-sun) 80%, white);
  }
</style>
