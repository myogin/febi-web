---
import { Image } from 'astro:assets';
import Doodle from './Doodle.astro';
import portrait from '../assets/febi.jpeg';
import { site, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { hero } = t(locale);
const [first, ...rest] = site.name.split(' ');
const last = rest.join(' ');
---
<section id="hero" class="hero" data-hero>
  <div class="hero__inner">
    <div class="hero__title">
      <p class="hero__hello" data-hero-hello>
        <span>{hero.hello}</span>
        <Doodle name="arrow" class="hero__arrow" stroke={4} />
      </p>

      <figure class="hero__photo" data-hero-photo>
        <span class="hero__tape hero__tape--a"></span>
        <span class="hero__tape hero__tape--b"></span>
        <div class="hero__photo-crop">
          <Image
            src={portrait}
            alt={hero.photoAlt}
            widths={[240, 480, 720]}
            sizes="(min-width: 48rem) 30vw, 14rem"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption>{hero.photoNote}</figcaption>
      </figure>

      <h1 class="hero__name" aria-label={site.name}>
        <span class="hero__line" aria-hidden="true"><span data-split data-hero-line="1">{first}</span></span>
        <span class="hero__line" aria-hidden="true"><span data-split data-hero-line="2">{last}</span></span>
      </h1>
    </div>

    <div class="hero__below">
      <div>
        <p class="hero__tagline" data-hero-fade>
          {
            hero.tagline.map((part) =>
              'mark' in part && part.mark === 'highlight' ? (
                <span class="mark-highlight">
                  <span class="mark-highlight__bg" data-highlight />
                  <span class="relative">{part.text}</span>
                </span>
              ) : 'mark' in part && part.mark === 'underline' ? (
                <span class="mark-underline">
                  {part.text}
                  <Doodle name="underline" class="mark-underline__line" stroke={5} />
                </span>
              ) : (
                part.text
              ),
            )
          }
        </p>
        <ul class="hero__chips">
          {hero.chips.map((chip) => <li data-hero-chip>{chip}</li>)}
        </ul>
      </div>

      <div class="hero__actions" data-hero-fade>
        <a class="btn" href={site.instagram} target="_blank" rel="noopener noreferrer" data-magnetic>
          {hero.cta}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>

    <div class="hero__foot" aria-hidden="true">
      <div class="hero__scroll" data-hero-scroll>
        <span>{hero.scroll}</span>
        <svg width="18" height="34" viewBox="0 0 18 34" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v28M2 23l7 8 7-8" /></svg>
      </div>
      <p class="hero__hint" data-hero-hint>{hero.dragHint}</p>
    </div>
  </div>

  <!-- Stiker dekoratif yang bisa digeser -->
  <div class="hero__stickers" aria-hidden="true">
    <div class="sticker sticker--star" data-sticker data-rot="-14">
      <svg viewBox="0 0 100 100"><path d="M50 6 L 62 37 L 95 38 L 68 58 L 78 92 L 50 72 L 22 92 L 32 58 L 5 38 L 38 37 Z" /></svg>
    </div>
    <div class="sticker sticker--year" data-sticker data-rot="12">
      <span class="sticker__small">class of</span>
      <span class="sticker__big">{site.classOf}</span>
    </div>
    <div class="sticker sticker--smile" data-sticker data-rot="-8">
      <svg viewBox="0 0 100 100"><circle cx="35" cy="40" r="6" /><circle cx="65" cy="40" r="6" /><path class="smile" d="M28 60 C 38 78, 62 78, 72 60" /></svg>
    </div>
    <div class="sticker sticker--tag" data-sticker data-rot="7">{hero.stickerTag}</div>
  </div>

</section>

<style>
  .hero {
    --name-size: clamp(3.4rem, 16.2vw, 17rem);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding: 6.5rem 1rem 6rem;
    overflow: clip;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 110rem;
    margin-inline: auto;
  }

  /* ── judul ── */
  .hero__title {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    column-gap: 1rem;
  }
  .hero__hello {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    margin: 0 0 0.4rem 0.2rem;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.2vw, 3.4rem);
    line-height: 1;
    rotate: -4deg;
    transform-origin: left bottom;
    color: var(--color-sky);
  }
  .hero__hello :global(.hero__arrow) {
    width: 1.5em;
    height: 1.1em;
    translate: 0 0.55em;
    color: var(--color-ink);
  }
  .hero__name {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--name-size);
    line-height: 0.86;
    letter-spacing: -0.055em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 85;
  }
  .hero__line {
    display: block;
    overflow: clip;
    padding-top: 0.05em;
  }
  .hero__line > span {
    display: inline-block;
    will-change: transform;
  }

  /* ── foto placeholder ── */
  .hero__photo {
    position: relative;
    display: grid;
    place-items: center;
    width: 6.75rem;
    aspect-ratio: 1 / 1.18;
    margin: 0 0.5rem 0.75rem 0;
    border: 3px solid var(--color-ink);
    border-radius: 0.6rem;
    background:
      repeating-linear-gradient(-45deg, transparent 0 10px, color-mix(in srgb, var(--color-ink) 7%, transparent) 10px 12px),
      var(--color-sun);
    box-shadow: var(--shadow-hard);
    rotate: 5deg;
  }
  /* Foto asli berformat tinggi (9:16); di sini dipotong ke badan atas. Atur posisi lewat object-position. */
  .hero__photo-crop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 0.35rem;
  }
  .hero__photo-crop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    scale: 1.75;
    transform-origin: 39% 40%;
  }
  .hero__photo figcaption {
    position: absolute;
    right: -0.6rem;
    bottom: -0.9rem;
    padding: 0.2rem 0.7rem;
    border: 2.5px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-paper);
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1;
    rotate: -6deg;
    white-space: nowrap;
    z-index: 1;
  }
  .hero__tape {
    position: absolute;
    z-index: 1;
    top: -0.7rem;
    width: 2.6rem;
    height: 1.1rem;
    background: color-mix(in srgb, var(--color-pop) 75%, white);
    border: 2px solid var(--color-ink);
    opacity: 0.95;
  }
  .hero__tape--a { left: -0.9rem; rotate: -38deg; }
  .hero__tape--b { right: -0.9rem; rotate: 34deg; }

  /* ── bawah judul ── */
  .hero__below {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.75rem;
  }
  .hero__tagline {
    max-width: 24ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.45rem, 3vw, 2.5rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .mark-highlight {
    position: relative;
    display: inline-block;
    padding-inline: 0.15em;
  }
  .mark-highlight__bg {
    position: absolute;
    inset: 0.12em -0.05em 0.02em;
    background: var(--color-sun);
    border-radius: 0.2em 0.5em 0.25em 0.45em;
    rotate: -1.5deg;
    transform-origin: left center;
  }
  .mark-underline {
    position: relative;
    display: inline-block;
  }
  .mark-underline :global(.mark-underline__line) {
    position: absolute;
    left: -2%;
    bottom: -0.32em;
    width: 104%;
    height: 0.4em;
    color: var(--color-pop);
  }
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }
  .hero__chips li {
    padding: 0.35rem 0.85rem;
    border: 2.5px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-paper);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .hero__chips li:nth-child(2) { rotate: -2deg; background: var(--color-paper-deep); }
  .hero__chips li:nth-child(3) { rotate: 1.5deg; }

  /* ── stiker ── */
  .hero__stickers {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .sticker {
    position: absolute;
    display: grid;
    place-items: center;
    pointer-events: auto;
    touch-action: none;
    user-select: none;
    filter: drop-shadow(3px 4px 0 var(--color-ink));
  }
  :global(html.js) .sticker { cursor: grab; }
  :global(html.js) .sticker:active { cursor: grabbing; }
  .sticker svg { width: 100%; height: 100%; overflow: visible; }

  .sticker--star { width: clamp(3.2rem, 7vw, 6rem); aspect-ratio: 1; left: 44%; top: 5.2rem; }
  .sticker--star path { fill: var(--color-sun); stroke: var(--color-ink); stroke-width: 5; stroke-linejoin: round; }

  .sticker--year {
    width: clamp(4.4rem, 8.5vw, 7.5rem);
    aspect-ratio: 1;
    right: 5%;
    bottom: 12.5rem;
    align-content: center;
    border: 3px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-sky);
    color: #fff;
    line-height: 0.95;
    text-align: center;
  }
  .sticker__small { font-family: var(--font-hand); font-weight: 600; font-size: clamp(0.95rem, 1.7vw, 1.4rem); }
  .sticker__big { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.25rem, 2.6vw, 2.3rem); letter-spacing: -0.04em; }

  .sticker--smile {
    width: clamp(3rem, 6vw, 5.2rem);
    aspect-ratio: 1;
    left: 5%;
    top: 6.4rem;
    border: 3px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-pop);
  }
  .sticker--smile circle { fill: var(--color-ink); }
  .sticker--smile .smile { fill: none; stroke: var(--color-ink); stroke-width: 6; stroke-linecap: round; }

  .sticker--tag {
    left: 20%;
    top: 10.2rem;
    padding: 0.3rem 0.9rem;
    border: 3px solid var(--color-ink);
    border-radius: 0.5rem;
    background: var(--color-leaf);
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.2vw, 1.9rem);
    white-space: nowrap;
  }

  .hero__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.25rem;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 1.3rem;
  }
  .hero__scroll {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero__hint {
    display: none;
    color: var(--color-ink-soft);
    rotate: -3deg;
  }
  :global(html.js) .hero__hint { display: block; }

  @media (min-width: 48rem) {
    .hero { padding: 7rem 2.5rem 7rem; }
    .hero__title { display: block; }
    .hero__photo {
      position: absolute;
      right: 2%;
      bottom: calc(var(--name-size) * 0.84);
      width: calc(var(--name-size) * 0.92);
      margin: 0;
      font-size: calc(var(--name-size) * 0.14);
      rotate: 6deg;
    }
    .hero__photo figcaption { font-size: clamp(1.1rem, 1.8vw, 1.7rem); }
    .hero__tape { width: 4rem; height: 1.5rem; top: -0.9rem; }
    .hero__below {
      grid-template-columns: 1fr auto;
      align-items: end;
      margin-top: 2.25rem;
    }
    .sticker--star { left: 47%; top: 21%; }
    .sticker--year { right: auto; left: 55%; bottom: auto; top: 30%; }
    .sticker--smile { right: auto; left: 56%; top: auto; bottom: 19%; }
    .sticker--tag { right: auto; left: 67%; top: auto; bottom: 14%; }
  }
</style>
