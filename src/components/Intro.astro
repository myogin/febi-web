---
import Doodle from './Doodle.astro';
import { site } from '../i18n';
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<!-- Layar pembuka. Hanya tampil bila JS aktif; ada pengaman CSS supaya tidak pernah macet. -->
<div class="intro" data-intro aria-hidden="true">
  <div class="intro__mark">
    <Doodle name="circle" class="intro__ring" stroke={6} />
    <span class="intro__initials">{site.initials}</span>
  </div>
  <p class="intro__label">{label}</p>
</div>

<style>
  .intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 80;
    place-items: center;
    align-content: center;
    gap: 1.25rem;
    background: var(--color-pop);
    color: var(--color-ink);
    /* pengaman: jika skrip gagal dimuat, layar ini hilang sendiri */
    animation: intro-failsafe 0.01s 5s forwards;
  }
  :global(html.js) .intro {
    display: grid;
  }
  .intro__mark {
    position: relative;
    display: grid;
    place-items: center;
    width: min(60vw, 17rem);
    aspect-ratio: 200 / 120;
  }
  .intro__mark :global(.intro__ring) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .intro__initials {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 14vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .intro__label {
    font-family: var(--font-hand);
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 600;
  }
  @keyframes intro-failsafe {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>
