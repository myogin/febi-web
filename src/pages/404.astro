---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/caveat';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Febi Maharani</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="grid min-h-dvh place-content-center gap-4 px-6 text-center">
      <p class="font-hand text-3xl font-semibold text-sky">oops — this page was never drawn</p>
      <h1 class="font-display text-[clamp(6rem,30vw,18rem)] font-extrabold leading-none tracking-[-0.06em]">404</h1>
      <p class="text-lg text-ink-soft">Halaman ini tidak ada. · This page doesn't exist.</p>
      <p class="mt-4 flex flex-wrap justify-center gap-3">
        <a class="btn" href="/">Home (EN)</a>
        <a class="btn" style="background: var(--color-sun)" href="/id/">Beranda (ID)</a>
      </p>
    </main>
  </body>
</html>
